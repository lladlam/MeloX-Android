{
  "base": {
    "id": "org.example.music",
    "name": "Example",
    "version": "1.0.0",
    "apiVersion": 1,
    "entry": "index.js",
    "capabilities": ["search", "playback", "lyrics"],
    "networkDomains": ["example.com"]
  },
  "cases": [
    { "name": "valid base", "patch": {}, "valid": true },
    { "name": "unsupported API", "patch": { "apiVersion": 2 }, "valid": false },
    { "name": "API string", "patch": { "apiVersion": "1" }, "valid": false },
    { "name": "fractional API", "patch": { "apiVersion": 1.2 }, "valid": false },
    { "name": "numeric ID", "patch": { "id": 123 }, "valid": false },
    { "name": "built-in ID", "patch": { "id": "netease" }, "valid": false },
    { "name": "ID namespace", "patch": { "id": "plugin:org.example" }, "valid": false },
    { "name": "traversal", "patch": { "entry": "../index.js" }, "valid": false },
    { "name": "absolute path", "patch": { "entry": "/index.js" }, "valid": false },
    { "name": "nested entry", "patch": { "entry": "bundle/index.js" }, "valid": true },
    { "name": "repeated capability", "patch": { "capabilities": ["search", "search"] }, "valid": false },
    { "name": "unsupported capability", "patch": { "capabilities": ["authentication"] }, "valid": false },
    { "name": "prerelease", "patch": { "version": "1.0.0-beta.1" }, "valid": true },
    { "name": "version alias", "patch": { "version": "01.0.0" }, "valid": false },
    { "name": "numeric prerelease alias", "patch": { "version": "1.0.0-beta.01" }, "valid": false },
    { "name": "empty version segment", "patch": { "version": "1.0.0-alpha..beta" }, "valid": false },
    { "name": "wildcard permission", "patch": { "networkDomains": ["*.example.com"] }, "valid": false },
    { "name": "case alias", "patch": { "networkDomains": ["EXAMPLE.COM"] }, "valid": false },
    { "name": "IP literal", "patch": { "networkDomains": ["127.0.0.1"] }, "valid": false },
    { "name": "null domains", "patch": { "networkDomains": null }, "valid": false },
    { "name": "empty name", "patch": { "name": "  " }, "valid": false },
    { "name": "publisher metadata", "patch": { "author": "Example Author", "homepage": "https://example.com/plugin" }, "valid": true },
    { "name": "empty author", "patch": { "author": " " }, "valid": false },
    { "name": "numeric author", "patch": { "author": 123 }, "valid": false },
    { "name": "local homepage", "patch": { "homepage": "file:///data/private" }, "valid": false },
    { "name": "userinfo homepage", "patch": { "homepage": "https://secret@example.com/" }, "valid": false },
    { "name": "all capabilities", "patch": { "capabilities": ["search", "playback", "lyrics", "playlists", "albums", "artists", "rankings", "homeFeed", "userLibrary", "favorites", "download", "authentication"], "authentication": { "type": "none" } }, "valid": true },
    { "name": "token permission subset", "patch": { "capabilities": ["authentication"], "authentication": { "type": "apiToken", "header": "Authorization", "prefix": "Bearer ", "domains": ["example.com"] } }, "valid": true },
    { "name": "token permission escape", "patch": { "capabilities": ["authentication"], "authentication": { "type": "apiToken", "header": "Authorization", "prefix": "Bearer ", "domains": ["other.example.com"] } }, "valid": false },
    { "name": "oauth public client", "patch": { "capabilities": ["authentication"], "authentication": { "type": "oauth2Pkce", "authorizationEndpoint": "https://example.com/authorize", "tokenEndpoint": "https://example.com/token", "clientId": "public", "scopes": ["music.read"], "domains": ["example.com"] } }, "valid": true },
    { "name": "oauth token domain escape", "patch": { "capabilities": ["authentication"], "authentication": { "type": "oauth2Pkce", "authorizationEndpoint": "https://example.com/authorize", "tokenEndpoint": "https://other.example.com/token", "clientId": "public", "scopes": [], "domains": ["example.com"] } }, "valid": false }
  ]
}
