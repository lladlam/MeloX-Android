{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melox.invalid/plugin/manifest-v1.schema.json",
  "title": "MeloX plugin manifest v1 (draft)",
  "x-capability-methods": {
    "search": ["search"], "playback": ["resolvePlayback"], "lyrics": ["lyrics"],
    "playlists": ["playlists", "searchPlaylists", "playlistDetail"],
    "albums": ["searchAlbums", "albumDetail"], "artists": ["searchArtists", "artistDetail"],
    "rankings": ["rankings", "rankingTracks"], "homeFeed": ["homeFeed"],
    "userLibrary": ["accountSummary", "userPlaylists", "savedAlbums", "followedArtists"],
    "favorites": ["isFavorite", "setFavorite"], "authentication": ["authenticationStatus"], "download": ["resolveDownload"]
  },
  "type": "object",
  "required": ["id", "name", "version", "apiVersion", "entry", "capabilities"],
  "properties": {
    "author": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "homepage": { "type": "string", "maxLength": 2048 },
    "id": { "type": "string", "maxLength": 121, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
    "version": { "type": "string", "maxLength": 80, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "apiVersion": { "const": 1 },
    "entry": { "type": "string", "maxLength": 512, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*\\.js$" },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["search", "playback", "lyrics", "playlists", "albums", "artists", "rankings", "homeFeed", "userLibrary", "favorites", "authentication", "download"] } },
    "authentication": { "oneOf": [
      { "type": "object", "required": ["type"], "properties": { "type": { "const": "none" } } },
      { "type": "object", "required": ["type", "header", "prefix", "domains"], "properties": {
        "type": { "const": "apiToken" }, "header": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,80}$" },
        "prefix": { "type": "string", "maxLength": 80, "pattern": "^[ -~]*$" },
        "domains": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } }
      } },
      { "type": "object", "required": ["type", "authorizationEndpoint", "tokenEndpoint", "clientId", "scopes", "domains"], "properties": {
        "type": { "const": "oauth2Pkce" },
        "authorizationEndpoint": { "type": "string", "maxLength": 2048 }, "tokenEndpoint": { "type": "string", "maxLength": 2048 },
        "clientId": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[!-~]+$" },
        "scopes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[!-~]+$" } },
        "domains": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string" } }
      } }
    ] },
    "networkDomains": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 253 } }
  },
  "allOf": [
    { "if": { "properties": { "capabilities": { "type": "array", "contains": { "const": "authentication" } } } }, "then": { "required": ["authentication"] } },
    { "if": { "required": ["authentication"] }, "then": { "properties": { "capabilities": { "type": "array", "contains": { "const": "authentication" } } } } }
  ]
}
