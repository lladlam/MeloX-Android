<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YTRear" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
    </style>

    <style name="ShapeAppearanceOverlay.YTRear.Art" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- Compact outlined button used by the collapsed diagnostics panel. -->
    <style name="Widget.YTRear.Button.Diagnostic" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">13sp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>

    <style name="TextAppearance.YTRear.SectionLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
</resources>
