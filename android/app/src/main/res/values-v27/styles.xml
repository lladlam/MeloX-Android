<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27 adds the light navigation-bar flag. Inherit the base style so
         version-qualified resource replacement does not drop shared items. -->
    <style name="Theme.MeloX" parent="Theme.MeloX.Base">
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
