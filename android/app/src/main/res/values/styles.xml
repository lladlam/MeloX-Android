<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Base style holds everything every API level needs. Version-qualified
      folders redefine `Theme.MeloX` and therefore *replace* this resource
      rather than merging into it, so they must inherit from this base.
    -->
    <style name="Theme.MeloX.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.MeloX" parent="Theme.MeloX.Base" />

    <!-- 整页推入/退回的页面 Activity 主题。
         ⚠⚠ 2026-10-02：**从半透明改成不透明**，转场完全交给平台。
         原先这里是 `Theme.MeloX.TransparentActivity`（windowIsTranslucent=true + 透明底），
         结果有两重代价：
         1. 半透明窗口在系统里走的是**另一套默认动画**（淡化），拿不到 ROM 的「新页自右侧滑入
            + 旧页小幅视差」那套原生转场；
         2. 因为看不到原生转场，各页面就在 Compose 里**自己写了一遍**整页位移
            （`AnimatedVisibility` + `meloXPageEnter`）—— 那是应用内动画，会被组合/绘制帧
            牵连，快速连续打断时必然有顿挫。
         现在改成不透明窗口 + 不覆盖 `windowAnimationStyle`（沿用平台默认），
         位置/速度连续性由 WindowManager 负责 ⇒ 天然可打断、天然带系统屏幕圆角。
         参考实现：Orange（com.baron.orange）的设置页转场 = 零 App 代码的 Activity 转场。

         `windowBackground` 必须是**页面底色**而不是透明：窗口不透明时，转场第一帧起就要有
         底色可画（否则会黑屏闪一下）。静态色只覆盖「跟随系统深色」这一种情形，App 内
         显式切浅/深色时由 `prepareMeloXPageWindow()` 在 onCreate 里按真实配色覆盖。 -->
    <style name="Theme.MeloX.Page" parent="Theme.MeloX">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/melox_page_background</item>
        <item name="android:colorBackground">@color/melox_page_background</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- ⚠ **只给「对话框式 Activity」用**（目前唯一调用点：MeloXListenTogetherInviteActivity）。
         那种 Activity 整屏只弹一个 AlertDialog、页面本体是空的 —— 它必须让下层 App 透出来当
         背景，所以必须保持半透明。**整页推入的页面一律用 `Theme.MeloX.Page`**（不透明），
         否则拿不到系统原生转场，见那里的说明。 -->
    <style name="Theme.MeloX.TransparentActivity" parent="Theme.MeloX">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
