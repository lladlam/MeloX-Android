<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- focus-api itself declares API 27 and SuperLyricApi declares API 26.
         MeloX only invokes them behind runtime guards (HyperOsFocusBridge on
         Android 8.1 + HyperOS 3; SuperLyricHelper.isAvailable() + a
         LinkageError catch around every call), so the app can safely keep
         its existing API 24 fallback support. -->
    <uses-sdk
        tools:overrideLibrary="com.xzakota.hyper.notification.focus,com.hchen.superlyricapi" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only used by the explicit 增量更新 action: rebuild the published APK from
         the installed one plus a BSDIFF40 patch and hand it to the installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="com.milink.service" />
    </queries>

    <application
        android:name=".MeloXApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeloX">

        <activity
            android:name=".core.plugin.PluginOAuthCallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.lladlam.melox.plugin" android:path="/oauth2redirect" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.sharing.PluginTrackLinkActivity" android:exported="true" android:theme="@style/Theme.MeloX.Page">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="melox" android:host="plugin-track" />
            </intent-filter>
        </activity>
        <service
            android:name=".core.plugin.PluginIsolatedService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":melox_plugin" />

        <!-- 冷启动性能：emoji2 是传递依赖（Compose Material3 带进来的）
             androidx.startup 初始化项。它在每次启动的主线程上跑
             EmojiCompat.MetadataRepo.create()，实测 ~165ms（atrace 确认），
             是本 App 最大的纯主线程启动阻塞。源码全程未使用 EmojiCompat /
             EmojiTextView API（Compose 的 emoji 走系统字体渲染），
             故直接从 InitializationProvider 摘掉，功能无损。
             若日后需要 emoji2，删掉这个 meta-data 覆盖即可恢复。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".platform.cli.MeloXCliReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:alwaysRetainTaskState="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 整页推入/退回的页面 Activity：不锁方向（跟随系统默认）。

             ⚠⚠ 2026-10-02：主题由 `Theme.MeloX.TransparentActivity` 换成
             `Theme.MeloX.Page`（**不透明窗口**）。半透明窗口在系统里拿不到 ROM 原生的
             Activity 转场（新页自右侧滑入 + 旧页视差），只能靠 App 在 Compose 里自研一遍；
             改成不透明 + 不覆盖 `windowAnimationStyle` 后，转场完全由 WindowManager 驱动
             ⇒ 天然位置/速度连续（可连续打断）、天然带系统屏幕圆角、天然支持预测式返回。

             ⚠⚠ 2026-10-14 卡顿修复：这批 Activity 原先**不声明 configChanges** —— 任何
             配置/尺寸变更都会销毁重建。第三方真机日志（官方包 0.6.4 / OPPO PLD110 /
             ColorOS V16）实证：MeloXSettingsDetailActivity 推入后窗口尺寸
             1080×2400→1272×2592（双轴 +192px）触发整页重建 + surface 重建 + Activity
             二次启动（checkFinished=false 4），空窗 ≥3s。现与 MainActivity 对齐补齐
             （另加 density|fontScale，覆盖系统字体缩放/浮窗密度变更）。
             ⚠ **故意不含 uiMode|locale**：深浅色 / 语言切换仍走销毁重建路径，
             让 `prepareMeloXPageWindow()` 按新主题重设窗口底色。 -->
        <activity android:name=".ui.account.MeloXAccountActivity" android:exported="false" android:theme="@style/Theme.MeloX.Page" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale" />
        <activity android:name=".ui.account.MeloXNeteaseLoginActivity" android:exported="false" android:theme="@style/Theme.MeloX.Page" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale" />
        <activity android:name=".ui.provider.MeloXProviderServicesActivity" android:exported="false" android:theme="@style/Theme.MeloX.Page" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale" />
        <activity android:name=".ui.settings.MeloXSettingsDetailActivity" android:exported="false" android:theme="@style/Theme.MeloX.Page" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale" />
        <!-- SpotifyCallbackActivity 已随上游 0.6.2 移除：登录改走 loopback
             （bed4a62 已删除 SpotifyCallbackActivity.kt，此处声明必须一并去掉）。 -->
        <activity android:name=".ui.collection.MeloXCollectionDetailActivity" android:exported="false" android:theme="@style/Theme.MeloX.Page" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale" />
        <activity android:name=".ui.song.MeloXSongWikiActivity" android:exported="false" android:theme="@style/Theme.MeloX.Page" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale" />
        <activity android:name=".ui.song.MeloXSongDetailActivity" android:exported="false" android:theme="@style/Theme.MeloX.Page" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale" />
        <!-- 对话框式 Activity（整屏只弹一个 AlertDialog、页面本体为空）⇒ 必须半透明让下层
             App 透出来当背景，保持 TransparentActivity；不要跟着上面那批换 Page 主题。 -->
        <activity android:name=".ui.player.MeloXListenTogetherInviteActivity" android:exported="false" android:theme="@style/Theme.MeloX.TransparentActivity" />
        <activity android:name=".ui.sharing.MeloXNeteaseResourceShareActivity" android:exported="true" android:theme="@style/Theme.MeloX.Page" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- ONNX Runtime registers its telemetry as a ContentProvider that runs on
             every cold start, collects a device id and calls a native hook that
             is absent from the Android build (UnsatisfiedLinkError in logcat).
             AutoSync inference is fully offline and local, so the provider is
             removed outright rather than merely muting its log. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/melox_file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />

        <service
            android:name=".playback.MeloXPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs user-requested full-track audio analysis in the background." />
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <service
            android:name=".platform.floating.MeloXFloatingLyricsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the currently playing lyric in a user-enabled overlay." />
        </service>

        <!-- 小米超级岛：服务类已随 b67a94c 摘入，此处补声明（暂未在播放服务里接线）。 -->
        <service
            android:name=".platform.xiaomi.XiaomiSuperIslandLyricService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live rendering of lyrics for Xiaomi Super Island" />
        </service>

        <!-- ShizukuKeepAliveService is a Shizuku user-service Binder, not an
             Android Service. It is bound through Shizuku.bindUserService and must
             not be declared here: a <service> entry would expose an instantiating
             component for a class that is not a Service. -->
        <meta-data android:name="lyricon_module" android:value="true" />
        <meta-data android:name="lyricon_module_author" android:value="lladlam" />
        <meta-data
            android:name="lyricon_module_description"
            android:value="MeloX player lyrics provider with word timing and translation support" />
        <meta-data
            android:name="lyricon_module_tags"
            android:resource="@array/lyricon_module_tags" />
    </application>
</manifest>
